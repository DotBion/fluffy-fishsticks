# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Gemini (App.py / App/src/App.py) ---
GEMINI_API_KEY=

# --- Alpha Vantage (dags/stocks_vantage.py, Scripts/*.py) ---
ALPHA_VANTAGE_API_KEY=

# --- MinIO object store ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Airflow webserver bootstrap account ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Airflow Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ---
FERNET_KEY=
