# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Gemini (App.py / App/src/App.py) ---
GEMINI_API_KEY=

# --- Alpha Vantage (pipeline/market.py, dags/stocks_vantage.py, scripts/*.py) ---
ALPHA_VANTAGE_API_KEY=
# alpha_vantage (default) or yfinance, which needs no key
MARKET_PROVIDER=alpha_vantage

# --- Training panel ---
# The tweet corpus covers AAPL, AMZN, GOOG, GOOGL, MSFT, TSLA over 2015-2020.
# GOOG and GOOGL are the same company, so the default keeps GOOGL only.
TICKERS=AAPL,AMZN,GOOGL,MSFT,TSLA
WINDOW_START=2015-01-01
WINDOW_END=2020-12-31
# Kaggle "Tweet Sentiment's Impact on Stock Returns" (~3M rows, not committed)
TWEET_CSV=/mnt/block/kaggle_datasets/Tweet.csv
COMPANY_TWEET_CSV=/mnt/block/kaggle_datasets/Company_Tweet.csv

# --- MinIO object store ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Airflow webserver bootstrap account ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Airflow Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ---
FERNET_KEY=
